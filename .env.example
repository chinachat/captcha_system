# 复制为 .env 后填写生产凭据（.env 已被 .gitignore 排除，不会入库）
# 生成密钥：openssl rand -hex 32
SECRET_KEY=change-me-please-openssl-rand-hex-32
ADMIN_USER=admin
ADMIN_PASS=change-me-please-strong-password
DEFAULT_API_KEY=change-me-please-api-key

# 可选：端口、基础镜像源、Redis
# CAPTCHA_PORT=8080
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# REDIS_URL=redis://redis:6379/0

# 可信代理（反向代理场景必配）：仅当请求真实来源 IP 命中列表时才信任 X-Forwarded-For
# 例如使用 Nginx 反代且与容器同机：TRUSTED_PROXIES=127.0.0.1
# TRUSTED_PROXIES=127.0.0.1
